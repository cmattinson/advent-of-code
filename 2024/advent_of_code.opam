# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Advent of Code solutions"
maintainer: ["Chris Mattinson <cmattinson@outlook.com>"]
authors: ["Chris Mattinson <cmattinson@outlook.com>"]
license: "MIT"
homepage: "https://github.com/cmattinson/advent-of-code"
bug-reports: "https://github.com/cmattinson/advent-of-code/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml"
  "core"
  "core_unix"
  "re"
  "ppx_let"
  "ppx_compare"
  "ppx_jane"
  "ppx_expect"
  "ppx_deriving"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cmattinson/advent-of-code.git"
